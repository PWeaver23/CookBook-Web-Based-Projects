# Copy this file to `.env` and fill in your own LOCAL values.
# `.env` is ignored by Git. Never commit real credentials.

# ----- MongoDB -----
# Local MongoDB (default port, no auth):
MONGODB_URI=mongodb://localhost:27017
# Hosted cluster format (e.g., MongoDB Atlas). Replace the placeholders:
# MONGODB_URI=mongodb+srv://your_username:your_password@your-cluster-host/

MONGODB_DATABASE=cookbook_db
